{
  "name": "etiquetas",
  "private": true,
  "version": "2.1.0",
  "description": "NOVA-ERP Etiquetas — gerador de etiquetas de preço para retalho",
  "author": "NOVA-ERP <arydsonmota@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview",
    "generate-icons": "node scripts/generate-icons.mjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:build": "npm run generate-icons && npm run build && electron-builder",
    "electron:build:portable": "npm run generate-icons && npm run build && electron-builder --win portable",
    "electron:build:installer": "npm run generate-icons && npm run build && electron-builder --win nsis",
    "publish:app": "npm run generate-icons && npm run build && electron-builder --win nsis --publish always",
    "release": "npm version patch && npm run publish:app && git push --follow-tags",
    "release:minor": "npm version minor && npm run publish:app && git push --follow-tags",
    "release:major": "npm version major && npm run publish:app && git push --follow-tags"
  },
  "build": {
    "appId": "cv.novaerp.etiquetas",
    "productName": "NOVA-ERP Etiquetas",
    "copyright": "Copyright © 2026 NOVA-ERP",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs"
    ],
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "pt_BR",
        "en"
      ],
      "language": "1046",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NOVA-ERP Etiquetas"
    },
    "publish": {
      "provider": "github",
      "owner": "Harrydevcod",
      "repo": "gerador-de-etiquetas",
      "private": false,
      "releaseType": "release"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "docx": "^9.6.1",
    "electron-updater": "^6.8.3",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.12.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.12",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vite-plugin-node-polyfills": "^0.26.0",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.5"
  }
}
